    given-names: Yufeng
    email: yufeng.zhai@desy.de
    affiliation: Deutsches Elektronen-Synchrotron DESY
version: 0.2.0
license: MIT
repository-code: "https://github.com/zyffcc/gisaxs_gui"
url: "https://github.com/zyffcc/gisaxs_gui"
keywords:
  - GISAXS
  - GIWAXS
  - grazing-incidence X-ray scattering
  - data reduction
  - small-angle scattering
  - thin films
  - in-situ series

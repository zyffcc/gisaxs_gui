 },
 "monotone": [
  "cap",
  "w_film"
 ],
 "reported": [
  {
   "name": "lnR_rel",
   "expr": "log(m.S.R)",
   "label": "island R (relative trend)",
   "unit": "ln nm",
   "status": "relative_trend",
   "note": "N5: not an absolute radius; island term is 0.1-5 % of the intensity late"
  },
  {
   "name": "f_isl",
   "expr": "exp(p['lnfisl'])",
   "label": "island mass share",
   "unit": "",
   "status": "conditional"
  },
  {
   "name": "k_opt",
   "expr": "exp(p['lnkopt'])",
   "label": "optical metal factor",
   "unit": "",
   "status": "conditional"
  },
  {
   "name": "cap",
   "expr": "p['kcap']",
   "label": "cap fraction",
   "unit": "",
   "status": "conditional",
   "note": "TOP-lite cap layer; where the film term is active the cap share often falls to ~0 and the film term carries the dense-metal signal: cap and w_film are not separately identified"
  },
  {
   "name": "sigma_z",
   "expr": "exp(p['lnszo'])",
   "label": "network sigma_z (nm)",
   "unit": "nm",
   "status": "identifiable_network",
   "note": "vertical correlation of the buried pore network, stable 1.2-3.4 nm"
  },
  {
   "name": "xi",
   "expr": "exp(p['lnxio'])",
   "label": "network xi (nm)",
   "unit": "nm",
   "status": "conditional"
  },
  {
   "name": "w_film",
   "expr": "p['phif'] / (1 + (0.1 * exp(p['lnLf']) / (2 * pi)) ** 4)",
   "label": "film share of the low-q substrate term at q = 0.1 nm^-1",
   "unit": "",
   "status": "conditional",
   "note": "IAM_TFILM: share of the large-scale TiO2 topography seen through the top-of-metal field; 0 early, grows with thickness (HiPIMS Au up to 0.44); a structural-change indicator, not a film thickness"
  },
  {
   "name": "lnL_f",
   "expr": "p['lnLf']",
   "label": "film crossover length (ln nm)",
   "unit": "ln nm",
   "status": "conditional",
   "note": "ln of the lateral length above which the topography is seen through the film term; exp = 10-45 nm where the term is active, undetermined (150-400 nm, outside the measured q range) where w_film ~ 0"
  }
 ],
 "hosts": [
  "TiO2"
 ]
}

  "IAM_SMOOTH": "1",
  "IAM_PIXMASK": "00a29e295663",
  "IAM_ONSET": "override",
  "IAM_SIGMAX": "0.3",
  "IAM_RMAX": "40",
  "IAM_FISLMAX": "3",
  "IAM_KOPTMAX": "3",
  "IAM_BURY": "1",
  "IAM_OZ": "1",
  "IAM_OZZ": "1",
  "IAM_TIO2_DEEP": "1",
  "IAM_TIO2_DEEP_NM": "1000",
  "IAM_Z0MAX": "1000",
  "IAM_COAT": "top",
  "IAM_GMAX": "1.0",
  "IAM_BURYGRID": "100,300,600",
  "IAM_COVMAX": "1.0",
  "IAM_AOZMAX": "1000",
  "IAM_TIO2_FIX": "1",
  "IAM_CAP": "1",
  "IAM_CAPPATCH": "1",
  "IAM_CAP_PLACE": "on",
  "IAM_CAP_AVG": "int",
  "IAM_PHICAPMIN": "0.6",
  "IAM_TCAPMAX": "30",
  "IAM_CAP0": "0.3",
  "IAM_PHICAP0": "0.9",
  "IAM_CP0": "0.4",
  "IAM_CAPGRID": "0.1,0.4,0.8",
  "IAM_CAP_WARMK": "0.02,0.3",
  "IAM_TFILM": "1"
 },
 "metals": [
  "Au",
  "Ag"
 ],
 "scalars": [
  "ln_hm_nominal",
  "t_rel",
  "metal"
 ],

# GIMaP example: ideal bulk rock-salt comparison with a = 6.462 Angstrom.
# The public Xeuss peaks differ from this cell; see the example README.
data_PbTe_bulk
_chemical_name_common 'PbTe (bulk rock salt)'
_cell_length_a 6.462
_cell_length_b 6.462
_cell_length_c 6.462
_cell_angle_alpha 90
_cell_angle_beta 90
_cell_angle_gamma 90
_space_group_name_H-M_alt 'F m -3 m'
loop_
_atom_site_label
_atom_site_type_symbol
_atom_site_fract_x
_atom_site_fract_y
_atom_site_fract_z
Pb1 Pb 0 0 0
Te1 Te 0.5 0.5 0.5

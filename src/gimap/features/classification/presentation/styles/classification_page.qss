QWidget#ClassificationPageRoot {
    background: #f5f7fb;
    color: #162033;
}

QLabel#classificationTitle {
    font-size: 18pt;
    font-weight: 700;
}

QLabel#classificationSubtitle {
    color: #5f6b7a;
}

QFrame#datasetSummaryFrame,
QFrame#qualityFrame,
QFrame#preprocessingFrame,
QFrame#validationFrame,
QFrame#projectionFrame,
QFrame#runFrame,
QFrame#overviewFrame,
QFrame#logPanel,
QFrame[classificationCard="true"] {
    background: #ffffff;
    border: 1px solid #dbe3ef;
    border-radius: 8px;
}

QFrame[classificationWorkflowHeader="true"] {
    background: #152238;
    border: 1px solid #223451;
    border-radius: 12px;
}

QFrame[classificationWorkflowStep="true"] {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 8px;
}

QFrame[classificationWorkflowStep="true"][workflowState="available"] {
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(255, 255, 255, 0.16);
}

QFrame[classificationWorkflowStep="true"][workflowState="running"] {
    background: #245dcb;
    border-color: #4f86e8;
}

QFrame[classificationWorkflowStep="true"][workflowState="complete"] {
    background: #173e3b;
    border-color: #2a756b;
}

QFrame[classificationWorkflowStep="true"][workflowState="error"] {
    background: #5f2027;
    border-color: #d05a67;
}

QFrame[classificationWorkflowStep="true"][workflowState="stale"] {
    background: #5c441b;
    border-color: #c89736;
}

QFrame[classificationWorkflowStep="true"][workflowState="blocked"] {
    background: rgba(255, 255, 255, 0.035);
    border-color: rgba(255, 255, 255, 0.07);
}

QFrame[classificationWorkflowStep="true"][workflowSelected="true"] {
    background: #245dcb;
    border: 2px solid #8db7ff;
}

QLabel[workflowTitle="true"] {
    color: #ffffff;
    font-size: 18px;
    font-weight: 700;
}

QLabel[workflowSubtitle="true"] {
    color: #b9c7da;
    font-size: 12px;
}

QLabel[workflowBadge="true"] {
    background: rgba(255, 255, 255, 0.14);
    border-radius: 11px;
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
}

QToolButton[workflowLabel="true"],
QToolButton[workflowLabel="true"]:checked,
QToolButton[workflowLabel="true"]:hover {
    min-height: 16px;
    padding: 0;
    color: #e8eef7;
    background: transparent;
    border: 0;
    font-size: 11px;
    font-weight: 600;
    text-align: left;
}

QLabel[workflowMessage="true"] {
    color: #c9d5e7;
    font-size: 9px;
}

QToolButton#classificationWorkflowGuidedButton {
    color: #dce7f7;
    background: rgba(255, 255, 255, 0.09);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 7px;
    padding: 5px 9px;
}

QToolButton#classificationWorkflowGuidedButton:hover,
QToolButton#classificationWorkflowGuidedButton:checked {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.16);
    border-color: rgba(255, 255, 255, 0.28);
}

QFrame#classificationContextBar,
QFrame#explorationSelectionPanel {
    background: transparent;
    border: 0;
}

QFrame#classificationContextBar {
    background: #f8fafc;
    border-top: 1px solid #e2e8f0;
    border-bottom: 1px solid #e2e8f0;
}

QLabel#sectionTitle {
    font-weight: 700;
    color: #1f2a44;
}

QLabel#stateBadgeLabel,
QLabel#qualityStatusLabel,
QLabel[classificationBadge="true"] {
    background: #e9f2ff;
    color: #0f4d8f;
    border-radius: 7px;
    padding: 3px 8px;
    font-weight: 600;
}

QLabel#stateBadgeLabel[classificationState="idle"] {
    background: #eef2f6;
    color: #475467;
}

QLabel#stateBadgeLabel[classificationState="running"] {
    background: #e8f1ff;
    color: #124c8b;
}

QLabel#stateBadgeLabel[classificationState="ready"] {
    background: #ecfdf3;
    color: #067647;
}

QLabel#stateBadgeLabel[classificationState="error"] {
    background: #fff1f2;
    color: #b42318;
}

QPushButton {
    min-height: 28px;
    padding: 4px 10px;
    border: 1px solid #c9d4e2;
    border-radius: 6px;
    background: #ffffff;
}

QPushButton:hover {
    background: #eef5ff;
    border-color: #9bb9dd;
}

QPushButton#runComparisonButton {
    min-height: 36px;
    background: #1767c2;
    color: #ffffff;
    border-color: #1767c2;
    font-weight: 700;
}

QPushButton#runComparisonButton:hover {
    background: #0f56a5;
}

QPushButton[classificationPrimaryAction="true"],
QPushButton[gimapPrimaryAction="true"] {
    min-height: 34px;
    background: #1767c2;
    color: #ffffff;
    border-color: #1767c2;
    font-weight: 700;
}

QPushButton[classificationPrimaryAction="true"]:hover,
QPushButton[gimapPrimaryAction="true"]:hover {
    background: #0f56a5;
}

QPushButton#addDataButton,
QPushButton#addClassButton,
QPushButton#scanImportButton {
    font-weight: 600;
}

QToolButton {
    min-height: 28px;
    padding: 4px 9px;
    border: 1px solid #c9d4e2;
    border-radius: 6px;
    background: #ffffff;
}

QToolButton:checked {
    background: #e8f1ff;
    color: #124c8b;
    border-color: #7aa7d9;
}

QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
    min-height: 26px;
    border: 1px solid #c9d4e2;
    border-radius: 5px;
    padding: 2px 6px;
    background: #ffffff;
}

QTableWidget,
QListWidget,
QTextBrowser,
QGraphicsView {
    background: #ffffff;
    border: 1px solid #d7dfeb;
    border-radius: 6px;
    gridline-color: #e6edf5;
}

QHeaderView::section {
    background: #eef3f8;
    color: #263449;
    padding: 5px 6px;
    border: 0;
    border-right: 1px solid #d7dfeb;
    font-weight: 600;
}

QProgressBar {
    min-height: 14px;
    border: 1px solid #c9d4e2;
    border-radius: 7px;
    background: #edf2f7;
    text-align: center;
}

QProgressBar::chunk {
    border-radius: 7px;
    background: #27a26a;
}

QLabel#validationWarningLabel {
    color: #a15c00;
}

QLabel#qualityStatusLabel[qualityState="empty"] {
    background: #f2f4f7;
    color: #475467;
}

QLabel#qualityStatusLabel[qualityState="ready"] {
    background: #ecfdf3;
    color: #067647;
}

QLabel#classificationPreviewEmptyState {
    background: rgba(248, 250, 253, 0.96);
    border: 1px dashed #b8c4d4;
    border-radius: 10px;
    color: #667085;
    padding: 18px;
}

QPushButton#preprocessingContinueButton {
    min-width: 240px;
}

QLabel#metricChartLabel {
    color: #5f6b7a;
}

QTabWidget#classificationResultTabs::pane {
    border: 1px solid #dbe3ef;
    border-radius: 6px;
    background: #ffffff;
}

QTabWidget#classificationResultTabs QTabBar::tab {
    min-width: 105px;
    padding: 7px 10px;
    color: #5f6b7a;
    border: 0;
    border-bottom: 2px solid transparent;
}

QTabWidget#classificationResultTabs QTabBar::tab:selected {
    color: #245dcb;
    border-bottom-color: #245dcb;
}

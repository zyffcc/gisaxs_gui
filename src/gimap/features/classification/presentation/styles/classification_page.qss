QWidget#ClassificationPageRoot {
    background: @surface_alt@;
    color: @text@;
}

QLabel#classificationTitle {
    font-size: @font_display_pt@;
    font-weight: 700;
}

QLabel#classificationSubtitle {
    color: @text_muted@;
}

QFrame#datasetSummaryFrame,
QFrame#qualityFrame,
QFrame#preprocessingFrame,
QFrame#validationFrame,
QFrame#projectionFrame,
QFrame#runFrame,
QFrame#overviewFrame,
QFrame#logPanel,
QFrame[classificationCard="true"] {
    background: @surface@;
    border: 1px solid @border@;
    border-radius: 8px;
}

/* The workflow header: a section like the others, its steps in the colours of the Analyze step rail. */
QFrame[classificationWorkflowHeader="true"] {
    background: @surface@;
    border: 1px solid @border@;
    border-radius: 10px;
}

QFrame[classificationWorkflowStep="true"] {
    background: @surface_alt@;
    border: 1px solid @border@;
    border-radius: 8px;
}

QFrame[classificationWorkflowStep="true"][workflowState="available"] {
    background: @surface@;
    border-color: @border_strong@;
}

QFrame[classificationWorkflowStep="true"][workflowState="running"] {
    background: @warning_soft@;
    border-color: @warning_border@;
}

QFrame[classificationWorkflowStep="true"][workflowState="complete"] {
    background: @success_soft@;
    border-color: @success_border@;
}

QFrame[classificationWorkflowStep="true"][workflowState="error"] {
    background: @danger_soft@;
    border-color: @danger_border@;
}

QFrame[classificationWorkflowStep="true"][workflowState="stale"] {
    background: @warning_soft@;
    border-color: @warning_border@;
}

QFrame[classificationWorkflowStep="true"][workflowState="blocked"] {
    background: @surface_alt@;
    border-color: @divider@;
}

QFrame[classificationWorkflowStep="true"][workflowSelected="true"] {
    background: @accent_soft@;
    border: 2px solid @accent@;
}

QLabel[workflowTitle="true"] {
    color: @text@;
    font-size: @font_heading_pt@;
    font-weight: 700;
}

QLabel[workflowSubtitle="true"] {
    color: @text_muted@;
    font-size: @font_pt@;
}

QLabel[workflowBadge="true"] {
    background: @surface_sunken@;
    border-radius: 11px;
    color: @text_muted@;
    font-size: @font_small_pt@;
    font-weight: 700;
}

QFrame[classificationWorkflowStep="true"][workflowSelected="true"] QLabel[workflowBadge="true"] {
    background: @accent@;
    color: @on_accent@;
}

QFrame[classificationWorkflowStep="true"][workflowState="complete"] QLabel[workflowBadge="true"] {
    background: @success@;
    color: @on_accent@;
}

QToolButton[workflowLabel="true"],
QToolButton[workflowLabel="true"]:checked,
QToolButton[workflowLabel="true"]:hover {
    min-height: 16px;
    padding: 0;
    color: @text@;
    background: transparent;
    border: 0;
    font-size: @font_small_pt@;
    font-weight: 600;
    text-align: left;
}

QFrame[classificationWorkflowStep="true"][workflowState="blocked"] QToolButton[workflowLabel="true"] {
    color: @text_faint@;
}

QLabel[workflowMessage="true"] {
    color: @text_muted@;
    font-size: @font_small_pt@;
}

QToolButton#classificationWorkflowGuidedButton {
    color: @text@;
    background: @surface@;
    border: 1px solid @border_strong@;
    border-radius: 7px;
    padding: 5px 9px;
}

QToolButton#classificationWorkflowGuidedButton:hover,
QToolButton#classificationWorkflowGuidedButton:checked {
    color: @accent@;
    background: @accent_soft@;
    border-color: @accent_border@;
}

QToolButton[workflowUtility="true"] {
    min-height: 24px;
    padding: 4px 8px;
    color: @text@;
    background: @surface@;
    border: 1px solid @border_strong@;
    border-radius: 6px;
}

QToolButton[workflowUtility="true"]:hover {
    color: @accent@;
    background: @accent_soft@;
    border-color: @accent_border@;
}

QFrame#classificationContextBar,
QFrame#explorationSelectionPanel {
    background: transparent;
    border: 0;
}

QFrame#classificationContextBar {
    background: @surface_alt@;
    border-top: 1px solid @divider@;
    border-bottom: 1px solid @divider@;
}

QLabel#sectionTitle {
    font-weight: 700;
    color: @text@;
}

QLabel#stateBadgeLabel,
QLabel#qualityStatusLabel,
QLabel[classificationBadge="true"] {
    background: @accent_soft@;
    color: @info@;
    border-radius: 7px;
    padding: 3px 8px;
    font-weight: 600;
}

QLabel#stateBadgeLabel[classificationState="idle"] {
    background: @bg@;
    color: @text_muted@;
}

QLabel#stateBadgeLabel[classificationState="running"] {
    background: @accent_soft@;
    color: @info@;
}

QLabel#stateBadgeLabel[classificationState="ready"] {
    background: @success_soft@;
    color: @success@;
}

QLabel#stateBadgeLabel[classificationState="error"] {
    background: @danger_soft@;
    color: @danger@;
}

QPushButton {
    min-height: 28px;
    padding: 4px 10px;
    border: 1px solid @border_strong@;
    border-radius: 6px;
    background: @surface@;
}

QPushButton:hover {
    background: @info_soft@;
    border-color: @info_border@;
}

QPushButton#runComparisonButton {
    min-height: 36px;
    background: @accent@;
    color: @on_accent@;
    border-color: @accent@;
    font-weight: 700;
}

QPushButton#runComparisonButton:hover {
    background: @accent_hover@;
}

QPushButton[classificationPrimaryAction="true"],
QPushButton[gimapPrimaryAction="true"] {
    min-height: 34px;
    background: @accent@;
    color: @on_accent@;
    border-color: @accent@;
    font-weight: 700;
}

QPushButton[classificationPrimaryAction="true"]:hover,
QPushButton[gimapPrimaryAction="true"]:hover {
    background: @accent_hover@;
}

QPushButton#addDataButton,
QPushButton#addClassButton,
QPushButton#scanImportButton {
    font-weight: 600;
}

QToolButton {
    min-height: 28px;
    padding: 4px 9px;
    border: 1px solid @border_strong@;
    border-radius: 6px;
    background: @surface@;
}

QToolButton:checked {
    background: @accent_soft@;
    color: @info@;
    border-color: @accent_border@;
}

QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
    min-height: 26px;
    border: 1px solid @border_strong@;
    border-radius: 5px;
    padding: 2px 6px;
    background: @surface@;
}

QTableWidget,
QListWidget,
QTextBrowser,
QGraphicsView {
    background: @surface@;
    border: 1px solid @border@;
    border-radius: 6px;
    gridline-color: @divider@;
}

QHeaderView::section {
    background: @surface_hover@;
    color: @text@;
    padding: 5px 6px;
    border: 0;
    border-right: 1px solid @border@;
    font-weight: 600;
}

QProgressBar {
    min-height: 14px;
    border: 1px solid @border_strong@;
    border-radius: 7px;
    background: @surface_hover@;
    text-align: center;
}

QProgressBar::chunk {
    border-radius: 7px;
    background: @success@;
}

QLabel#validationWarningLabel {
    color: @warning@;
}

QLabel#qualityStatusLabel[qualityState="empty"] {
    background: @bg@;
    color: @text_muted@;
}

QLabel#qualityStatusLabel[qualityState="ready"] {
    background: @success_soft@;
    color: @success@;
}

QLabel#classificationPreviewEmptyState {
    background: @surface_alt@;
    border: 1px dashed @border_strong@;
    border-radius: 10px;
    color: @text_muted@;
    padding: 18px;
}

QPushButton#preprocessingContinueButton {
    min-width: 240px;
}

QLabel#metricChartLabel {
    color: @text_muted@;
}

QTabWidget#classificationResultTabs::pane {
    border: 1px solid @border@;
    border-radius: 6px;
    background: @surface@;
}

QTabWidget#classificationResultTabs QTabBar::tab {
    min-width: 105px;
    padding: 7px 10px;
    color: @text_muted@;
    border: 0;
    border-bottom: 2px solid transparent;
}

QTabWidget#classificationResultTabs QTabBar::tab:selected {
    color: @accent@;
    border-bottom-color: @accent@;
}

/* Feature-owned modern visual layer for Prediction. */

#gisaxsPredictPageContents,
#predictionLeftContents,
#predictionRightContents {
    background: @surface_alt@;
}

#predictionControlRail {
    background: @surface_alt@;
    border: none;
}
QFrame[predictionStickyRun="true"] {
    background: @surface@;
    border: 1px solid @border@;
    border-radius: 10px;
}

/* The workflow header: a section like the others, its steps in the colours of the Analyze step rail. */
QFrame[predictionWorkflowHeader="true"] {
    background: @surface@;
    border: 1px solid @border@;
    border-radius: 10px;
}
QLabel[predictionWorkflowTitle="true"] {
    color: @text@;
    font-size: @font_heading_pt@;
    font-weight: 700;
}
QFrame[predictionWorkflowStep="true"] {
    background: @surface_alt@;
    border: 1px solid @border@;
    border-radius: 8px;
}
QFrame[predictionWorkflowStep="true"][workflowState="active"] {
    background: @accent_soft@;
    border-color: @accent_border@;
}
QFrame[predictionWorkflowStep="true"][workflowState="complete"] {
    background: @success_soft@;
    border-color: @success_border@;
}
QFrame[predictionWorkflowStep="true"][workflowState="running"] {
    background: @warning_soft@;
    border-color: @warning_border@;
}
QFrame[predictionWorkflowStep="true"][workflowState="error"] {
    background: @danger_soft@;
    border-color: @danger_border@;
}
QLabel[predictionWorkflowBadge="true"] {
    background: @surface_sunken@;
    border-radius: 11px;
    color: @text_muted@;
    font-weight: 700;
}
QFrame[predictionWorkflowStep="true"][workflowState="active"] QLabel[predictionWorkflowBadge="true"] {
    background: @accent@;
    color: @on_accent@;
}
QFrame[predictionWorkflowStep="true"][workflowState="complete"] QLabel[predictionWorkflowBadge="true"] {
    background: @success@;
    color: @on_accent@;
}
QLabel[predictionWorkflowLabel="true"] {
    color: @text@;
    font-weight: 600;
}

QFrame#gimapPredictSection,
QFrame[gimapSection="true"] {
    background: @surface@;
    border: 1px solid @divider@;
    border-radius: 10px;
}

QFrame#predictionModeSelector {
    background: @surface_hover@;
    border: 1px solid @border@;
    border-radius: 9px;
}
QFrame#predictionModeSelector QRadioButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 7px;
    color: @text_muted@;
    font-weight: 600;
    padding: 8px 12px;
}
/* A segmented switch: no radio dot or square is drawn at all (size, border, image and margin all gone). */
QFrame#predictionModeSelector QRadioButton::indicator {
    width: 0;
    height: 0;
    border: none;
    background: transparent;
    image: none;
    margin: 0;
}
QFrame#predictionModeSelector QRadioButton:checked {
    background: @surface@;
    border-color: @border@;
    color: @accent@;
}

QFrame#gisaxsPredictRangePanel {
    background: @surface_alt@;
    border: 1px solid @divider@;
    border-radius: 8px;
}
QLabel[predictionFieldLabel="true"] {
    color: @text_muted@;
    font-size: @font_small_pt@;
    font-weight: 600;
}
QLabel[predictionBatchSummary="true"] {
    background: @info_soft@;
    border: 1px solid @border@;
    border-radius: 7px;
    color: @info@;
    font-weight: 600;
    padding: 8px 10px;
}

QToolButton[predictionDisclosure="true"] {
    background: transparent;
    border: none;
    color: @text_muted@;
    font-weight: 600;
    padding: 5px 2px;
    text-align: left;
}
QToolButton[predictionDisclosure="true"]:hover { color: @accent@; }

QPushButton[gimapPrimaryAction="true"] {
    background: @accent@;
    border: 1px solid @accent@;
    color: @on_accent@;
    font-weight: 650;
}
QPushButton[gimapPrimaryAction="true"]:hover { background: @accent_hover@; }
/* A disabled Predict / Import must not look ready. */
QPushButton[gimapPrimaryAction="true"]:disabled {
    background: @disabled_bg@;
    border-color: @border@;
    color: @text_disabled@;
}
QPushButton[gimapDangerAction="true"] {
    background: @danger_soft@;
    border-color: @danger_border@;
    color: @danger@;
}
QPushButton[gimapDangerAction="true"]:disabled {
    background: @surface_alt@;
    border-color: @border@;
    color: @text_disabled@;
}

QLabel[predictionReadiness="true"] {
    background: @surface_alt@;
    border: 1px solid @divider@;
    border-radius: 7px;
    padding: 7px 9px;
    font-weight: 600;
}
/* Text colour comes from the gimapRole (success / muted / error); the chip tints with it. */
QLabel[predictionReadiness="true"][gimapRole="success"] {
    background: @success_soft@;
    border-color: @success_border@;
}
QLabel[predictionReadiness="true"][gimapRole="error"] {
    background: @danger_soft@;
    border-color: @danger_border@;
}
QLabel#predictionCanvasStatusLabel[busy="true"] {
    color: @info@;
    font-weight: 600;
}
QLabel[predictionModelStatus="true"] {
    background: @surface_alt@;
    border: 1px solid @border@;
    border-radius: 7px;
    color: @text_muted@;
    padding: 8px 10px;
}
QLabel[predictionModelStatus="true"][modelState="ready"] {
    background: @success_soft@;
    border-color: @success_border@;
    color: @success@;
}
QLabel[predictionModelStatus="true"][modelState="working"] {
    background: @warning_soft@;
    border-color: @warning_border@;
    color: @warning@;
}
QLabel[predictionEmptyState="true"] {
    background: @surface_alt@;
    border: 1px dashed @border_strong@;
    border-radius: 10px;
    color: @text_muted@;
    padding: 18px;
}

#gisaxsPredictImageShowTabWidget::pane {
    background: @surface@;
    border: 1px solid @border@;
    border-radius: 10px;
    top: -1px;
}
#gisaxsPredictImageShowTabWidget QTabBar::tab {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    color: @text_muted@;
    min-width: 120px; /* both tabs fit the canvas column of a 1024 px window */
    min-height: 34px;
    padding: 4px 12px;
    font-weight: 600;
}
#gisaxsPredictImageShowTabWidget QTabBar::tab:selected {
    border-bottom-color: @accent@;
    color: @accent@;
}

QFrame#predictPreviewSection {
    background: @surface_alt@;
    border: 1px solid @border@;
    border-radius: 8px;
}

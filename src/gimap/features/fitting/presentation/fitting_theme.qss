/* Feature-owned visual layer for the Fitting workbench. */

#gisaxsFittingWorkspaceSplitter,
#gisaxsWorkAreaContents,
#gisaxsRightCollapsiblePanel {
    background: @surface_alt@;
}

#fittingContextBar {
    background: @surface@;
    border: none;
    border-bottom: 1px solid @divider@;
}

#fittingContextLabel {
    font-size: @font_title_pt@;
}

QPushButton[fittingContextButton="true"] {
    color: @text_muted@;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 7px;
    min-height: 28px;
    padding: 2px 14px;
    font-weight: 600;
}

QPushButton[fittingContextButton="true"]:hover {
    background: @surface_hover@;
}

QPushButton[fittingContextButton="true"]:checked {
    color: @accent@;
    background: @accent_soft@;
    border-color: @info_border@;
}

#fittingInsituSeriesPage {
    background: @surface_alt@;
}

#fittingInsituTitleLabel {
    color: @text@;
    font-size: @font_display_pt@;
    font-weight: 700;
}

#fittingInsituRecipeStatusLabel {
    border-radius: 7px;
    padding: 7px 9px;
    font-weight: 600;
}

#fittingInsituRecipeStatusLabel[statusKind="warning"] {
    color: @warning@;
    background: @warning_soft@;
}

#fittingInsituRecipeStatusLabel[statusKind="complete"] {
    color: @success@;
    background: @success_soft@;
}

#fittingInsituModeTabs::pane {
    background: @surface@;
    border: 1px solid @border@;
    border-radius: 10px;
    top: -1px;
}

#fittingInsituModeTabs QTabBar::tab {
    color: @text_muted@;
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    min-width: 72px;
    min-height: 34px;
    padding: 4px 6px;
    font-weight: 600;
}

#fittingInsituModeTabs QTabBar::tab:selected {
    color: @accent@;
    border-bottom-color: @accent@;
}

QFrame[fittingWorkflowHeader="true"] {
    background: @rail@;
    border: 1px solid @rail_border@;
    border-radius: 12px;
}

QLabel[workflowTitle="true"] {
    color: #ffffff;
    font-size: @font_heading_pt@;
    font-weight: 700;
}

QLabel[workflowSubtitle="true"] {
    color: #b9c7da;
    font-size: @font_pt@;
}

QFrame[fittingWorkflowStep="true"] {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 8px;
}

QFrame[fittingWorkflowStep="true"][workflowState="available"] {
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(255, 255, 255, 0.16);
}

QFrame[fittingWorkflowStep="true"][workflowState="running"] {
    background: #245dcb;
    border-color: #4f86e8;
}

QFrame[fittingWorkflowStep="true"][workflowState="complete"] {
    background: #173e3b;
    border-color: #2a756b;
}

QFrame[fittingWorkflowStep="true"][workflowState="error"] {
    background: #5f2027;
    border-color: #d05a67;
}

QFrame[fittingWorkflowStep="true"][workflowState="stale"] {
    background: #5c441b;
    border-color: #c89736;
}

QFrame[fittingWorkflowStep="true"][workflowState="blocked"] {
    background: rgba(255, 255, 255, 0.035);
    border-color: rgba(255, 255, 255, 0.07);
}

/* Selection means navigation position; state colors above mean verified work. */
QFrame[fittingWorkflowStep="true"][workflowSelected="true"] {
    background: #245dcb;
    border: 2px solid #8db7ff;
}

QLabel[workflowBadge="true"] {
    background: rgba(255, 255, 255, 0.14);
    border-radius: 11px;
    color: #ffffff;
    font-size: @font_small_pt@;
    font-weight: 700;
}

QLabel[workflowLabel="true"] {
    color: #e8eef7;
    font-size: @font_small_pt@;
    font-weight: 600;
}

QLabel[workflowMessage="true"] {
    color: #c9d5e7;
    font-size: @font_small_pt@;
}

#fittingWorkflowGuidedButton {
    color: #dce7f7;
    background: rgba(255, 255, 255, 0.09);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 7px;
    padding: 5px 9px;
}

QFrame[previewToolbar="true"],
QFrame[displayInspector="true"] {
    background: @surface_alt@;
    border: 1px solid @divider@;
    border-radius: 8px;
}

QFrame[previewToolbar="true"] QToolButton:checked {
    color: @on_accent@;
    background: @accent@;
    border-color: @accent@;
}

#fittingDetectorToolHint {
    color: @text_muted@;
}

#fittingInlineFeedback {
    background: @danger_soft@;
    border: 1px solid @danger_border@;
    border-radius: 8px;
    color: @danger@;
    padding: 8px 10px;
}

#fittingInlineFeedback[feedbackKind="info"] {
    background: @info_soft@;
    border-color: @info_border@;
    color: @info@;
}

#fittingInlineFeedback[feedbackKind="warning"] {
    background: @warning_soft@;
    border-color: @warning_border@;
    color: @warning@;
}

#fittingResultStatusChip {
    border-radius: 9px;
    padding: 4px 9px;
    background: @surface_hover@;
    color: @text_muted@;
    font-weight: 600;
}

#fittingResultStatusChip[statusKind="complete"],
#fittingResultStatusChip[statusKind="ready"] {
    background: @success_soft@;
    color: @success@;
}

#fittingResultStatusChip[statusKind="running"] {
    background: @info_soft@;
    color: @accent@;
}

#fittingResultStatusChip[statusKind="error"] {
    background: @danger_soft@;
    color: @danger@;
}

#fittingResultStatusChip[statusKind="stale"] {
    background: @warning_soft@;
    color: @warning@;
}

QFrame[gimapSection="true"] {
    background: @surface@;
    border: 1px solid @divider@;
    border-radius: 10px;
}

#fittingInputSection,
#fittingConfigureSection,
#fittingRunSection,
#fittingAdvancedSection,
#GisaxsInputCard,
#CutLineCard,
#FittingControlsCard,
#ModelParameterCard {
    background: transparent;
    border: none;
    border-radius: 0;
}

#fittingPreviewPanel,
#fittingResultsPanel,
#fittingCutResultsPanel {
    background: transparent;
    border: none;
}

#fittingPreviewTabs::pane,
#fittingModeTabs::pane {
    background: @surface@;
    border: 1px solid @border@;
    border-radius: 10px;
    top: -1px;
}

#fittingPreviewTabs QTabBar::tab {
    background: transparent;
    color: @text_muted@;
    border: none;
    border-bottom: 2px solid transparent;
    min-width: 120px;
    min-height: 34px;
    padding: 4px 12px;
    font-weight: 600;
}

#fittingModeTabs QTabBar::tab {
    background: transparent;
    color: @text_muted@;
    border: none;
    border-bottom: 2px solid transparent;
    min-width: 0px;
    min-height: 30px;
    padding: 4px 4px;
    font-weight: 600;
}

#fittingPreviewTabs QTabBar::tab:selected,
#fittingModeTabs QTabBar::tab:selected {
    color: @accent@;
    border-bottom-color: @accent@;
}

QToolButton[fittingDisclosure="true"] {
    background: transparent;
    border: none;
    color: @text_muted@;
    font-weight: 600;
    padding: 5px 2px;
    text-align: left;
}

QToolButton[fittingDisclosure="true"]:hover {
    color: @accent@;
}

QPushButton[gimapPrimaryAction="true"] {
    background: @accent@;
    border: 1px solid @accent@;
    color: @on_accent@;
    font-weight: 650;
}

QPushButton[gimapPrimaryAction="true"]:hover {
    background: @accent_hover@;
}

QPushButton#FittingGlobalSearchButton,
QPushButton#FittingAutoRefineButton {
    padding-left: 4px;
    padding-right: 4px;
}

QPushButton[gimapDangerAction="true"] {
    color: @danger@;
    border-color: @danger_border@;
    background: @danger_soft@;
}

/* Nothing running: Stop stays quiet (this sheet overrides the application's own :disabled rule). */
QPushButton[gimapDangerAction="true"]:disabled {
    color: @text_disabled@;
    border-color: @border@;
    background: @disabled_bg@;
}

QPushButton[gimapPrimaryAction="true"]:disabled {
    background: @accent_border@;
    border-color: @accent_border@;
    color: @on_accent@;
}

QLabel[fittingSetupBadge="true"] {
    background: @info_soft@;
    border: 1px solid @info_border@;
    border-radius: 7px;
    color: @accent@;
    font-size: @font_small_pt@;
    font-weight: 600;
    padding: 5px 8px;
}

QLabel[fittingEmptyState="true"] {
    background: @surface_alt@;
    border: 1px dashed @border_strong@;
    border-radius: 10px;
    color: @text_muted@;
    font-size: @font_pt@;
    padding: 18px;
}

QFrame[card="true"],
QFrame[sectionCard="true"] {
    background: @surface@;
    border: 1px solid @divider@;
    border-radius: 8px;
}

QGroupBox {
    border: none;
    margin-top: 10px;
    padding-top: 10px;
    background: transparent;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
    color: @text_muted@;
    font-weight: 600;
}

QFrame[insituWorkflowBar="true"] {
    background: @surface_alt@;
    border: 1px solid @divider@;
    border-radius: 9px;
}

QToolButton[insituWorkflowStep="true"] {
    min-height: 34px;
    padding: 4px 8px;
    color: @text_muted@;
    background: transparent;
    border: none;
    border-radius: 7px;
    font-weight: 600;
}

QToolButton[insituWorkflowStep="true"]:hover {
    color: @accent@;
    background: @info_soft@;
}

QToolButton[insituWorkflowStep="true"]:checked {
    color: @on_accent@;
    background: @accent@;
}

QToolButton[insituWorkflowStep="true"][workflowState="complete"]:!checked,
QToolButton[insituWorkflowStep="true"][workflowState="configured"]:!checked {
    color: @success@;
    background: @success_soft@;
}

QToolButton[insituWorkflowStep="true"][workflowState="running"]:!checked {
    color: @accent@;
    background: @info_soft@;
}

QToolButton[insituWorkflowStep="true"][workflowState="error"]:!checked {
    color: @danger@;
    background: @danger_soft@;
}

#fittingInsituParameterStack,
#fittingInsituPreviewTabs::pane {
    background: @surface@;
    border: 1px solid @border@;
    border-radius: 9px;
}

#fittingInsituParameterStack {
    padding: 6px 8px;
}

#fittingInsituPreviewTabs QTabBar::tab {
    min-height: 32px;
    min-width: 92px;
    padding: 4px 10px;
    color: @text_muted@;
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    font-weight: 600;
}

#fittingInsituPreviewTabs QTabBar::tab:selected {
    color: @accent@;
    border-bottom-color: @accent@;
}

QGroupBox[fittingPlainGroup="true"] {
    border: none;
    margin-top: 10px;
    padding-top: 10px;
    background: transparent;
}

QGroupBox[fittingPlainGroup="true"]::title {
    subcontrol-origin: margin;
    left: 0;
    padding: 0;
    font-weight: 600;
}

QWidget[fittingParticleCard="true"] {
    background: @surface@;
    border: 1px solid @border@;
    border-radius: 10px;
}

QWidget[fittingParticleHeader="true"] {
    background: @surface_alt@;
    border: 1px solid @divider@;
    border-radius: 8px;
}

QWidget[fittingParticleTypeGroup="true"] {
    background: @surface@;
    border: 1px solid @border@;
    border-radius: 6px;
}

QLabel[fittingParticleTitle="true"] {
    border: none;
    color: @text@;
    font-weight: 700;
    padding: 0 2px 0 0;
}

QLabel[fittingParticleTypeLabel="true"] {
    border: none;
    color: @text_muted@;
    font-weight: 600;
    padding-left: 8px;
    padding-right: 2px;
}

QComboBox[fittingParticleShape="true"] {
    border: none;
    background: transparent;
    padding-left: 2px;
    padding-right: 24px;
}

QPushButton[fittingParticleRemove="true"] {
    background: @surface_alt@;
    border: 1px solid @border_strong@;
    border-radius: 6px;
    color: @text@;
    font-weight: 600;
    padding: 3px 10px;
}

QPushButton[fittingParticleRemove="true"]:hover {
    background: @surface_hover@;
}

/* The single-curve page: panels as in Analyze. */
QFrame#fitCommandBar,
QFrame#fitProcessPanel,
QFrame#fitPlotPanel {
    background: @surface@;
    border: 1px solid @border@;
    border-radius: 10px;
}

QLabel#fitCurveChip {
    color: @text@;
    font-weight: 600;
    padding: 0 4px;
}

QLabel#fitWarnings {
    color: @warning@;
}
